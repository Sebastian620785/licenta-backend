# Copiaza acest fisier in .env si ajusteaza valorile.
NODE_ENV=development
PORT=3000

# Conexiunea la PostgreSQL pornit cu `npm run db:up`
DATABASE_URL=postgresql://licenta:licenta@localhost:5432/licenta?schema=public

# Originea frontend-ului (React/Vite) acceptata de CORS
CORS_ORIGIN=http://localhost:5173

# Nivelul de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
